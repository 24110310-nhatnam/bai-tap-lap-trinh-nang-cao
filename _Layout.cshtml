<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLTV</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Sach" asp-action="Index">QLTV - Quản lý thư viện</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Sach" asp-action="Index">Sách</a>
                <a class="nav-link" asp-controller="TacGia" asp-action="Index">Tác giả</a>
            </div>
        </div>
    </nav>
</header>
<main class="container pb-4">
    @RenderBody()
</main>
<footer class="border-top footer text-muted py-3">
    <div class="container">Ứng dụng quản lý thư viện - ASP.NET Core MVC & Entity Framework Core Code First</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
