@model IEnumerable<TacGia>
@{
    ViewData["Title"] = "Danh sách tác giả";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách tác giả</h1>
    <a asp-action="Create" class="btn btn-primary">+ Thêm tác giả</a>
</div>
<p><a asp-controller="Sach" asp-action="Index">Quản lý sách</a></p>
<table class="table table-striped table-hover">
    <thead><tr><th>Tên tác giả</th><th>Quốc tịch</th><th>Số sách</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TenTacGia</td>
            <td>@item.QuocTich</td>
            <td>@item.SachList.Count</td>
            <td class="text-nowrap">
                <a asp-action="Details" asp-route-id="@item.TacGiaId">Chi tiết</a> |
                <a asp-action="Edit" asp-route-id="@item.TacGiaId">Sửa</a> |
                <a asp-action="Delete" asp-route-id="@item.TacGiaId">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
