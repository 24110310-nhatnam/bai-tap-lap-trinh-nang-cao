@model TacGia
@{
    ViewData["Title"] = "Xóa tác giả";
}
<h1>Xóa tác giả</h1>
@if (Model.SachList.Count > 0)
{
    <div class="alert alert-danger">Tác giả này đang có @Model.SachList.Count sách. Hãy xóa hoặc chuyển các sách trước khi xóa tác giả.</div>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
}
else
{
    <div class="alert alert-warning">Bạn có chắc chắn muốn xóa tác giả này không?</div>
    <p><strong>@Model.TenTacGia</strong> — @Model.QuocTich</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="TacGiaId" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
}
