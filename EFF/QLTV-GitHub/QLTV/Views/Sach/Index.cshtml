@model IEnumerable<Sach>
@{
    ViewData["Title"] = "Danh sách sách";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách sách</h1>
    <a asp-action="Create" class="btn btn-primary">+ Thêm sách</a>
</div>
<p><a asp-controller="TacGia" asp-action="Index">Quản lý tác giả</a></p>
<table class="table table-striped table-hover">
    <thead><tr><th>Tên sách</th><th>Năm xuất bản</th><th>Tác giả</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TenSach</td>
            <td>@item.NamXuatBan</td>
            <td>@item.TacGia?.TenTacGia</td>
            <td class="text-nowrap">
                <a asp-action="Details" asp-route-id="@item.SachId">Chi tiết</a> |
                <a asp-action="Edit" asp-route-id="@item.SachId">Sửa</a> |
                <a asp-action="Delete" asp-route-id="@item.SachId">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
